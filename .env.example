# 配置参考文件；应用不会自动读取 .env，请在终端或服务管理器中显式设置。
# 生产环境必须设置随机 SECRET_KEY，且不能启用 FLASK_DEBUG=1。
SECRET_KEY=replace-with-a-new-random-secret
FLASK_DEBUG=0
# 默认使用本仓库 instance/ygo.db 与 uploads/。
DATABASE_URL=
UPLOAD_FOLDER=
# 只保护已经显式授予管理员的同名账号，不会让注册自动获权。
ADMIN_USERNAME=
# 仅在应用确实只接受受控反向代理请求时设为1。
TRUST_PROXY_HEADERS=0
HOST=127.0.0.1
PORT=8080
